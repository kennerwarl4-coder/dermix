# Copie estas linhas nas Environment Variables do projeto na Vercel.
# NUNCA preencha valores reais neste arquivo nem o suba pro git com a chave dentro.
SIGILOPAY_PUBLIC_KEY=
SIGILOPAY_SECRET_KEY=

# URL fixa do site (sem barra no final) — usada como callbackUrl dos webhooks.
# Opcional: se nao definir, cai no padrao https://dermix-self.vercel.app
PUBLIC_SITE_URL=https://dermix-self.vercel.app

# Banco Upstash Redis (gratis) -> console.upstash.com -> Create Database -> aba REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Meta Conversions API (Purchase server-side) -> Events Manager > Fontes de dados >
# seu Pixel > Configuracoes > Conversions API > Gerar token de acesso
META_PIXEL_ID=1430862615843602
META_CAPI_ACCESS_TOKEN=
